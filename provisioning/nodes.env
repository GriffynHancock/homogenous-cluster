# Fleet inventory.
#
# LAN IPs are used for the RPC mesh. Tailscale is admin/web only -- never put
# RPC on it: encryption on the per-token hot path is pure loss, and upstream
# explicitly warns against exposing RPC to any network it does not trust.
#
# Fields: <hostname> <lan-ip> <ram_mb> <physical-cores>
#
# RAM_MB drives --tensor-split and must be MEASURED (`free -m`), not assumed.
# CORES is PHYSICAL cores, not nproc -- measured on node 1, -t 8 is 26% slower
# than -t 4 for generation because SMT siblings contend for the memory pipe.
# Get it with:
#   lscpu -p=Core,Socket | grep -v '^#' | sort -u | wc -l
#
# Node 1 is the master and also runs a worker rpc-server.

NODES=(
  "node1 10.10.0.34 128709 4"
  "node2 10.10.0.39 128709 4"
  # --- nodes 3-7: fill in as each is provisioned. Do NOT guess these values. ---
  # "node3 10.10.0.XX ????? ?"
  # "node4 10.10.0.XX ????? ?"
  # "node5 10.10.0.XX ????? ?"
  # "node6 10.10.0.XX ????? ?"
  # "node7 10.10.0.XX ????? ?"
)

RPC_PORT=50052
MASTER_IP=10.10.0.34

# Node 1's RAM_MB was 125629 until 2026-08-17. That value is NOT what `free -m`
# reports and its origin is unknown; both nodes measure 128709 MB (MemTotal
# 131798676 kB). Corrected, because RAM_MB sets --tensor-split ratios and a
# 2.4% skew between physically identical nodes would misweight the split.
#
# INFERENCE ENDPOINTS are not the same list as RPC endpoints. Under the
# replicated topology (R independent llama-servers) Missing Link must fan out
# across these; under sharding they would be one coordinator. Kept separate
# deliberately -- see STATUS.md task 2.
INFERENCE_ENDPOINTS=(
  "http://10.10.0.34:8080"
  "http://10.10.0.39:8080"
)

# Measured per node -- see docs/measurements.md. F12: memory bandwidth, not RAM
# capacity, sets generation speed, and core count is a BANDWIDTH spec.
#   STREAM triad peak, node1: 28.2 GB/s (2026-08-12), 28.4 GB/s (2026-08-17 re-run)
#   STREAM triad peak, node2: 27.9 GB/s (2026-08-17)
# Node 2 is within 1.8% of node 1 and has an identical DIMM layout
# (4 x 32 GB DDR4-2400, all four channels). Treat the fleet as homogeneous in
# bandwidth for now; --tensor-split by RAM is therefore also correct by
# bandwidth. Re-check per node -- this is an empirical result, not a guarantee.
#
# LINK SPEED IS 100 Mb/s, NOT GIGABIT (measured 93.8 Mbit/s = 11.7 MB/s).
# Both NICs support and advertise 1000baseT/Full, so the cap is the cable or
# switch port, not the hardware. This matters: it makes peer-to-peer model
# pull SLOWER than downloading from HuggingFace (21 MB/s measured, F23).
